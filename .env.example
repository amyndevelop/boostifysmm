DATABASE_URL=postgresql://boostify:CHANGE_ME@localhost:5432/boostify
APP_URL=http://localhost:3000
# demo is isolated from production: only the demo adapter can submit in demo.
APP_MODE=demo
# Clave maestra del servidor: 32 bytes aleatorios codificados en 64 caracteres hex.
# Desarrollo: node scripts/init-provider-key.mjs (no sobrescribe una clave existente).
# Guardar y respaldar de forma segura; cambiarla sin recifrar vuelve ilegibles las API keys.
PROVIDER_ENCRYPTION_KEY=
# Opcional: secreto para el planificador de pedidos (no reutilizar la clave maestra).
CRON_SECRET=
# Emergencia: poner false pausa nuevas compras y nuevos envíos.
# ORDERS_ENABLED=false

# Firma secreta entregada por Mercado Pago Developers → Webhooks. Solo servidor.
# Vercel: definir en Production y volver a desplegar; nunca NEXT_PUBLIC_.
# URL de notificaciones: https://boostifysmm.vercel.app/api/webhooks/mercadopago
MERCADOPAGO_WEBHOOK_SECRET=
# Access Token: se carga cifrado desde /admin/recargas, no requiere otra variable.
